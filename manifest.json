{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3",
  "default_locale": "es",
  "description": "__MSG_extDescription__",

  "browser_specific_settings": {
    "gecko": {
      "id": "{38c8e3a2-1e4f-4f5d-8a7b-9c0d1e2f3a4b}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["storage"],

  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none';"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_defaultTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://*.booking.com/*"],
      "js": ["browser-polyfill.min.js", "i18n.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
